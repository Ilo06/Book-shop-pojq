              "path": ["sales", "{{saleId}}"]
            }
          }
        },
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"saleDate\": \"2025-06-10\",\n  \"bookCopyIds\": [\n    \"d4e5f6a7-4444-4000-8000-000000000005\",\n    \"d4e5f6a7-4444-4000-8000-000000000016\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sales",
              "host": ["{{base_url}}"],
              "path": ["sales"]
