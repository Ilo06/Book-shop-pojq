{
  "info": {
    "name": "Poja Book API",
    "description": "Postman collection for testing the Poja Book Management API.\n\nBase URL: {{base_url}}\n\nDefault data uses UUIDs from init2.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Genres",
      "item": [
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/genres?page=0&size=20&sort=name",
              "host": ["{{base_url}}"],
              "path": ["genres"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "name" }
              ]
            }
          }
        },
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/genres", "host": ["{{base_url}}"], "path": ["genres"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science-Fiction\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get genre",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/genres/{{genreId}}", "host": ["{{base_url}}"], "path": ["genres", "{{genreId}}"] }
          }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/genres/{{genreId}}", "host": ["{{base_url}}"], "path": ["genres", "{{genreId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science-Fiction\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete genre",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/genres/{{genreId}}", "host": ["{{base_url}}"], "path": ["genres", "{{genreId}}"] }
          }
        }
      ]
    },
    {
      "name": "Authors",
      "item": [
        {
          "name": "List authors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/authors?page=0&size=20&sort=lastName",
              "host": ["{{base_url}}"],
              "path": ["authors"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "lastName" }
              ]
            }
          }
        },
        {
          "name": "Create author",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/authors", "host": ["{{base_url}}"], "path": ["authors"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"George\",\n  \"lastName\": \"Orwell\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get author",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/authors/{{authorId}}", "host": ["{{base_url}}"], "path": ["authors", "{{authorId}}"] }
          }
        },
        {
          "name": "Update author",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/authors/{{authorId}}", "host": ["{{base_url}}"], "path": ["authors", "{{authorId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"George\",\n  \"lastName\": \"Orwell\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete author",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/authors/{{authorId}}", "host": ["{{base_url}}"], "path": ["authors", "{{authorId}}"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                { "key": "genreId", "value": "", "disabled": true },
                { "key": "authorId", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/books", "host": ["{{base_url}}"], "path": ["books"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984\",\n  \"isbn\": \"9780451524935\",\n  \"description\": \"Dystopian classic.\",\n  \"publishDate\": \"1949-06-08\",\n  \"genreIds\": [],\n  \"authorIds\": []\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get book",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/books/{{bookId}}", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}"] }
          }
        },
        {
          "name": "Update book",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/books/{{bookId}}", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984\",\n  \"isbn\": \"9780451524935\",\n  \"description\": \"Updated description.\",\n  \"publishDate\": \"1949-06-08\",\n  \"genreIds\": [],\n  \"authorIds\": []\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete book",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/books/{{bookId}}", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}"] }
          }
        },
        {
          "name": "Get book stock",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/stock",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "stock"],
              "query": [
                { "key": "detailed", "value": "false", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get all books stock",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/books/stock", "host": ["{{base_url}}"], "path": ["books", "stock"] }
          }
        },
        {
          "name": "Get low stock books",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/books/stock/low-stock", "host": ["{{base_url}}"], "path": ["books", "stock", "low-stock"] }
          }
        }
      ]
    },
    {
      "name": "Book Copies",
      "item": [
        {
          "name": "List copies",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/books/{{bookId}}/copies", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}", "copies"] }
          }
        },
        {
          "name": "Create copy",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/books/{{bookId}}/copies", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}", "copies"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PAPERBACK\",\n  \"price\": 12.99,\n  \"location\": \"A1-Shelf3\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get copy",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}", "copies", "{{copyId}}"] }
          }
        },
        {
          "name": "Patch copy",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}", "copies", "{{copyId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 14.99,\n  \"location\": \"B2-Shelf1\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete copy",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}", "copies", "{{copyId}}"] }
          }
        },
        {
          "name": "Get copy stock",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}/stock", "host": ["{{base_url}}"], "path": ["books", "{{bookId}}", "copies", "{{copyId}}", "stock"] }
          }
        }
      ]
    },
    {
      "name": "Arrivals",
      "item": [
        {
          "name": "List arrivals",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/arrivals", "host": ["{{base_url}}"], "path": ["arrivals"] }
          }
        },
        {
          "name": "Create arrival",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/arrivals", "host": ["{{base_url}}"], "path": ["arrivals"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arrivalDateTime\": \"2026-07-07T10:00:00Z\",\n  \"books\": [\n    {\n      \"bookCopyId\": \"{{copyId}}\",\n      \"quantity\": 5\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get arrival",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/arrivals/{{arrivalId}}", "host": ["{{base_url}}"], "path": ["arrivals", "{{arrivalId}}"] }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "List sales",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sales",
              "host": ["{{base_url}}"],
              "path": ["sales"],
              "query": [
                { "key": "from", "value": "2024-01-01T00:00:00Z", "disabled": true },
                { "key": "to", "value": "2026-12-31T23:59:59Z", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create sale",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/sales", "host": ["{{base_url}}"], "path": ["sales"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"creationDateTime\": \"2026-07-07T12:00:00Z\",\n  \"isReservation\": false,\n  \"quantifiedBookCopyList\": [\n    {\n      \"bookCopyId\": \"{{copyId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get sale",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/sales/{{saleId}}", "host": ["{{base_url}}"], "path": ["sales", "{{saleId}}"] }
          }
        },
        {
          "name": "Finalize sale",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/sales/{{saleId}}/finalize?confirm=true",
              "host": ["{{base_url}}"],
              "path": ["sales", "{{saleId}}", "finalize"],
              "query": [{ "key": "confirm", "value": "true" }]
            }
          }
        },
        {
          "name": "Today revenue",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/sales/today-revenue", "host": ["{{base_url}}"], "path": ["sales", "today-revenue"] }
          }
        },
        {
          "name": "Monthly revenue",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/sales/monthly-revenue", "host": ["{{base_url}}"], "path": ["sales", "monthly-revenue"] }
          }
        },
        {
          "name": "Top sellers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sales/top-sellers?limit=10",
              "host": ["{{base_url}}"],
              "path": ["sales", "top-sellers"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Revenue by genre",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/sales/revenue-by-genre", "host": ["{{base_url}}"], "path": ["sales", "revenue-by-genre"] }
          }
        }
      ]
    },
    {
      "name": "Health",
