{
  "info": {
    "name": "Poja Book API",
    "description": "Postman collection for testing the Poja Book Management API.\n\nBase URL: {{base_url}}\n\nDefault data uses UUIDs from init2.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "bookId",
      "value": "c3d4e5f6-3333-4000-8000-000000000001"
    },
    {
      "key": "copyId",
      "value": "d4e5f6a7-4444-4000-8000-000000000001"
    },
    {
      "key": "saleId",
      "value": "e5f6a7b8-5555-4000-8000-000000000001"
    },
    {
      "key": "authorId",
      "value": "b2c3d4e5-2222-4000-8000-000000000001"
    },
    {
      "key": "genreId",
      "value": "a1b2c3d4-1111-4000-8000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Genres",
      "item": [
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/genres?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["genres"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get genre by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/genres/{{genreId}}",
              "host": ["{{base_url}}"],
              "path": ["genres", "{{genreId}}"]
            }
          }
        },
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mystery\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/genres",
              "host": ["{{base_url}}"],
              "path": ["genres"]
            }
          }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PUT",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science Fiction\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/genres/{{genreId}}",
              "host": ["{{base_url}}"],
              "path": ["genres", "{{genreId}}"]
            }
          }
        },
        {
          "name": "Delete genre",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/genres/{{genreId}}",
              "host": ["{{base_url}}"],
              "path": ["genres", "{{genreId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Authors",
      "item": [
        {
          "name": "List authors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["authors"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get author by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors/{{authorId}}",
              "host": ["{{base_url}}"],
              "path": ["authors", "{{authorId}}"]
            }
          }
        },
        {
          "name": "Create author",
          "request": {
            "method": "POST",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Terry\",\n  \"lastName\": \"Pratchett\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/authors",
              "host": ["{{base_url}}"],
              "path": ["authors"]
            }
          }
        },
        {
          "name": "Update author",
          "request": {
            "method": "PUT",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"George\",\n  \"lastName\": \"Orwell\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/authors/{{authorId}}",
              "host": ["{{base_url}}"],
              "path": ["authors", "{{authorId}}"]
            }
          }
        },
        {
          "name": "Delete author",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/authors/{{authorId}}",
              "host": ["{{base_url}}"],
              "path": ["authors", "{{authorId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "List books (filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?genreId={{genreId}}&search=dune",
              "host": ["{{base_url}}"],
              "path": ["books"],
              "query": [
                { "key": "genreId", "value": "{{genreId}}" },
                { "key": "search", "value": "dune" }
              ]
            }
          }
        },
        {
          "name": "Get book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Neuromancer\",\n  \"isbn\": \"9780441569598\",\n  \"description\": \"A sci-fi novel about a washed-up computer hacker hired for one last job.\",\n  \"publishDate\": \"1984-07-01\",\n  \"genreId\": \"a1b2c3d4-1111-4000-8000-000000000001\",\n  \"authorIds\": [\"b2c3d4e5-2222-4000-8000-000000000004\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/books",
              "host": ["{{base_url}}"],
              "path": ["books"]
            }
          }
        },
        {
          "name": "Update book",
          "request": {
            "method": "PUT",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"1984 (Updated)\",\n  \"isbn\": \"9780451524935\",\n  \"description\": \"A dystopian novel set in a totalitarian society ruled by Big Brother.\",\n  \"publishDate\": \"1949-06-08\",\n  \"genreId\": \"a1b2c3d4-1111-4000-8000-000000000001\",\n  \"authorIds\": [\"b2c3d4e5-2222-4000-8000-000000000001\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Delete book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Book Copies",
      "item": [
        {
          "name": "List copies of a book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/copies",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "copies"]
            }
          }
        },
        {
          "name": "List copies of a book (filter by status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/copies?status=AVAILABLE",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "copies"],
              "query": [
                { "key": "status", "value": "AVAILABLE" }
              ]
            }
          }
        },
        {
          "name": "Get copy by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "copies", "{{copyId}}"]
            }
          }
        },
        {
          "name": "Create copy",
          "request": {
            "method": "POST",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"c3d4e5f6-3333-4000-8000-000000000001\",\n  \"type\": \"PAPERBACK\",\n  \"price\": 14.99,\n  \"location\": \"Shelf A1\",\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/copies",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "copies"]
            }
          }
        },
        {
          "name": "Patch copy",
          "request": {
            "method": "PATCH",
            "header": ["Content-Type: application/json"],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SOLD_OUT\",\n  \"price\": 9.99\n}"
            },
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "copies", "{{copyId}}"]
            }
          }
        },
        {
          "name": "Delete copy",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{bookId}}/copies/{{copyId}}",
              "host": ["{{base_url}}"],
              "path": ["books", "{{bookId}}", "copies", "{{copyId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "List sales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sales",
              "host": ["{{base_url}}"],
              "path": ["sales"]
            }
          }
        },
        {
          "name": "List sales (date range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sales?from=2024-01-01&to=2025-12-31",
              "host": ["{{base_url}}"],
              "path": ["sales"],
              "query": [
                { "key": "from", "value": "2024-01-01" },
                { "key": "to", "value": "2025-12-31" }
              ]
            }
          }
        },
        {
          "name": "Get sale by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sales/{{saleId}}",
