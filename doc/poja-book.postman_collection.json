          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/ping", "host": ["{{base_url}}"], "path": ["ping"] }
          }
        },
        {
          "name": "Health DB",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health/db", "host": ["{{base_url}}"], "path": ["health", "db"] }
          }
        },
        {
          "name": "Health email",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health/email?to=test@example.com",
              "host": ["{{base_url}}"],
              "path": ["health", "email"],
              "query": [{ "key": "to", "value": "test@example.com" }]
            }
          }
        }
      ]
    }
  ],
